generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GolfCourse {
  id              String   @id
  name            String
  city            String?
  state           String?
  latitude        Float?
  longitude       Float?
  par             Int?
  detailsJson     Json?
  detailsCachedAt DateTime?
  updatedAt       DateTime @updatedAt

  users       User[]
  tournaments Tournament[]
  outings     Outing[]
  playRounds  PlayRound[]

  @@index([name])
  @@index([state])
}

model User {
  id            String   @id @default(cuid())
  slug          String?  @unique
  email         String   @unique
  password      String
  role          String   @default("member")  // "member" | "admin"
  firstName     String   @default("")
  lastName      String   @default("")
  cellNumber    String?
  ghinNumber    String?
  handicapIndex Float?
  homeCourse    String?
  homeCourseId  String?
  homeCourseRef GolfCourse? @relation(fields: [homeCourseId], references: [id], onDelete: SetNull)
  imageUrl      String?
  scgaOfficial  Boolean  @default(false)
  createdAt     DateTime @default(now())
  tournamentRegistrations TournamentRegistration[]
  tournamentFlightMembers TournamentFlightMember[]
  tournamentFoursomeMembers TournamentFoursomeMember[]
  comments      Comment[]
  surveySelections SurveyDateSelection[]
  surveysCreated   Survey[] @relation("SurveyCreator")
  passwordResetTokens PasswordResetToken[]
  outingsCreated   Outing[] @relation("OutingCreator")
  outingParticipants OutingParticipant[]
  playRoundsCreated PlayRound[] @relation("PlayRoundCreator")
  playRoundPlayers PlayRoundPlayer[]
  favorites        MemberFavorite[] @relation("UserFavorites")
  favoritedBy      MemberFavorite[] @relation("FavoritedByUsers")
  pushTokens       PushToken[]
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MemberFavorite {
  id         String   @id @default(cuid())
  userId     String
  favoriteId String
  createdAt  DateTime @default(now())
  user       User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  favorite   User     @relation("FavoritedByUsers", fields: [favoriteId], references: [id], onDelete: Cascade)

  @@unique([userId, favoriteId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Survey {
  id            String   @id @default(cuid())
  slug          String?  @unique // URL slug from title, e.g. dates-you-can-play-in-march-2026
  type          String   @default("availability") // "availability" | "multiple_choice"
  title         String?  // custom question for multiple_choice; availability titles are computed from month/year
  allowMultiple Boolean  @default(true) // multiple_choice: can members pick more than one option?
  month         Int?     // 1–12 (availability only)
  year          Int?     // (availability only)
  endsAt        DateTime? // when voting closes; null = no deadline (legacy)
  createdAt     DateTime @default(now())
  createdById   String?
  createdBy     User?    @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  options       SurveyDateOption[]
  selections    SurveyDateSelection[]
}

model SurveyDateOption {
  id         String    @id @default(cuid())
  surveyId   String
  date       DateTime? @db.Date // availability options
  label      String?   // multiple_choice options
  imageUrl   String?   // multiple_choice options may be a thumbnail image instead of (or with) text
  sortOrder  Int       @default(0)
  survey     Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  selections SurveyDateSelection[]
  @@unique([surveyId, date])
  @@unique([surveyId, label])
}

model SurveyDateSelection {
  id       String           @id @default(cuid())
  surveyId String
  userId   String
  optionId String
  survey   Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  option   SurveyDateOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  @@unique([surveyId, userId, optionId])
}

model Tournament {
  id             String   @id @default(cuid())
  slug           String?  @unique
  name           String
  description    String?  // Short description shown under the title
  date           DateTime
  startTime      String?  // "HH:mm" local tee time, e.g. "08:30"
  course         String
  courseId       String?
  courseRef      GolfCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  scoringFormat  String
  individualOrTeam String @default("individual")  // "individual" | "team"
  teamSize       Int?    // 2 or 4 when team
  availableSpots Int
  greenFee       Float   @default(0)
  prizePool      Float   @default(0)
  clubDonation   Float   @default(0)
  paymentMethod  String?  // "venmo" | "cash"
  venmoUsername  String?
  prizes         String?  // JSON array: [{ name: string, amount: number }]
  createdAt      DateTime @default(now())
  registrations  TournamentRegistration[]
  comments       Comment[]
  playRound      PlayRound?
  flights        TournamentFlight[]
  foursomes      TournamentFoursome[]
}

model TournamentFlight {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  sortOrder    Int      @default(0)
  minHandicap  Float?
  maxHandicap  Float?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members      TournamentFlightMember[]

  @@index([tournamentId])
}

model TournamentFlightMember {
  id       String           @id @default(cuid())
  flightId String
  userId   String
  flight   TournamentFlight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flightId, userId])
  @@index([userId])
}

model TournamentFoursome {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  sortOrder    Int      @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members      TournamentFoursomeMember[]

  @@index([tournamentId])
}

model TournamentFoursomeMember {
  id         String @id @default(cuid())
  foursomeId String
  userId     String
  foursome   TournamentFoursome @relation(fields: [foursomeId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([foursomeId, userId])
  @@index([userId])
}

model TournamentRegistration {
  id            String   @id @default(cuid())
  tournamentId  String
  userId        String
  paymentStatus String   @default("unpaid")  // "unpaid" | "pending" | "confirmed"
  handicapIndex Float?
  createdAt     DateTime @default(now())
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, userId])
}

model Outing {
  id            String   @id @default(cuid())
  slug          String?  @unique
  playerCount   Int
  course        String
  courseId      String?
  courseRef     GolfCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  hasBookedTime Boolean  @default(false)
  date          DateTime?
  startTime     String?  // "HH:mm" when hasBookedTime
  timeOfDay     String?  // "morning" | "midday" | "afternoon"
  hasWager      Boolean  @default(false)
  wagerDetails  String?
  status        String   @default("open") // open | full | cancelled
  kind          String   @default("social") // social | play
  createdById   String
  createdBy     User     @relation("OutingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  participants  OutingParticipant[]
}

model OutingParticipant {
  id       String @id @default(cuid())
  outingId String
  userId   String
  role     String @default("player") // organizer | player
  status   String @default("invited") // invited | confirmed | declined
  outing   Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([outingId, userId])
}

model PlayRound {
  id          String   @id @default(cuid())
  slug        String   @unique
  course      String
  courseId    String?
  courseRef   GolfCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tournamentId String? @unique
  tournament  Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  holeCount   Int      @default(18)
  status      String   @default("in_progress") // in_progress | completed
  createdById String
  createdBy   User     @relation("PlayRoundCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  players     PlayRoundPlayer[]
}

model PlayRoundPlayer {
  id             String   @id @default(cuid())
  playRoundId    String
  userId         String
  scores         Json     @default("{}")
  handicapIndex  Float?
  playRound      PlayRound @relation(fields: [playRoundId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playRoundId, userId])
}

model Comment {
  id           String    @id @default(cuid())
  tournamentId String
  userId       String
  parentId     String?   // null = top-level, otherwise reply to parent
  content      String
  createdAt    DateTime  @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]  @relation("CommentReplies")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  subject     String
  htmlBody    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
